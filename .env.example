# Copy to .env and fill in real values. Never commit .env.

# Required. All open-weight generation, critic and pairwise traffic.
OPENROUTER_API_KEY=sk-or-...

# Required. OpenAI / Anthropic / Google models are routed here automatically
# by config.py:is_us_key_model.
OPENROUTER_US_API_KEY=sk-or-...

# Optional but recommended. Phase 1-A paper search and the dynamic_search judge.
# Free key: https://api.semanticscholar.org
SEMANTIC_SCHOLAR_API_KEY=

# Optional. Fallback reference lookup for Phase 1-B2.
# Free key: https://serper.dev
SERPER_API_KEY=

# Optional. Only needed for models served through NVIDIA NIM.
NVIDIA_API_KEY=

# Optional. Endpoint for an OpenAI-compatible internal gateway, used only when a
# model id carries a gateway route prefix (azure/, aws/, gcp/, ...). Leave unset
# unless you have access to one; the public routes do not need it.
NV_INTERNAL_BASE_URL=
